# =============================================================================
# Airymax SDK Go — .gitignore
# 策略：非必要不追踪。仅忽略本地构建产物与运行时数据，
#       源码与必要配置保持可追踪，避免误推远程仓库
# =============================================================================

# ---------- Go 构建产物 ----------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# ---------- Go 测试覆盖率 ----------
cover.out
cover.html

# ---------- Go 模块 ----------
vendor/

# ---------- IDE 与编辑器配置 ----------
.vscode/
.idea/
.vs/
.trae/
*.code-workspace

# ---------- 环境与密钥（禁止入库） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ---------- 运行时数据 ----------
*.log
*.sock
*.db
*.tmp
*.bak

# ---------- 操作系统文件 ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- 编辑器临时文件 ----------
*.swp
*.swo
*~
